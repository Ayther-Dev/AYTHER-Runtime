{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ci-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_FIND_USE_PACKAGE_REGISTRY": "OFF",
        "CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY": "OFF",
        "CMAKE_PREFIX_PATH": "$env{AYTHER_ENGINE_PREFIX}",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-ci",
      "displayName": "Windows CI (RelWithDebInfo)",
      "description": "Visual Studio 2026 and MSVC v145 against the locked Engine package.",
      "inherits": "ci-base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "v145",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-qa",
      "displayName": "Windows QA (RelWithDebInfo, audio QA Engine)",
      "description": "windows-ci against the QA Engine lock (dependencies/ayther-engine.qa.lock.json); set AYTHER_ENGINE_PREFIX from tools/bootstrap_ayther_engine_qa.ps1. Spec 002, BR-118.",
      "inherits": "windows-ci",
      "cacheVariables": {
        "AYTHER_REQUIRE_AUDIO_QA_ENGINE_PACKAGE": "ON",
        "AYTHER_ENABLE_GPU_TESTS": "OFF"
      }
    },
    {
      "name": "windows-qa-gpu",
      "displayName": "Windows QA with GPU tests",
      "description": "windows-qa plus the tests that need a GPU and a desktop session.",
      "inherits": "windows-qa",
      "cacheVariables": {
        "AYTHER_REQUIRE_AUDIO_QA_ENGINE_PACKAGE": "ON",
        "AYTHER_ENABLE_GPU_TESTS": "ON"
      }
    },
    {
      "name": "linux-ci",
      "displayName": "Linux CI (RelWithDebInfo)",
      "description": "Ninja build against the locked Linux Engine package.",
      "inherits": "ci-base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-quality",
      "displayName": "Linux quality (clang-tidy + coverage)",
      "inherits": "linux-ci",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "AYTHER_ENABLE_CLANG_TIDY": "ON",
        "AYTHER_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "linux-sanitizers",
      "displayName": "Linux ASan/UBSan + fuzz",
      "inherits": "linux-ci",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "AYTHER_ENABLE_SANITIZERS": "ON",
        "AYTHER_ENABLE_FUZZING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-ci",
      "configurePreset": "windows-ci",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-qa",
      "configurePreset": "windows-qa",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-qa-gpu",
      "configurePreset": "windows-qa-gpu",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-ci",
      "configurePreset": "linux-ci"
    },
    {
      "name": "linux-quality",
      "configurePreset": "linux-quality"
    },
    {
      "name": "linux-sanitizers",
      "configurePreset": "linux-sanitizers"
    }
  ],
  "testPresets": [
    {
      "name": "windows-ci",
      "configurePreset": "windows-ci",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-qa",
      "configurePreset": "windows-qa",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "gpu"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-qa-gpu",
      "configurePreset": "windows-qa-gpu",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-ci",
      "configurePreset": "linux-ci",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-quality",
      "configurePreset": "linux-quality",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-sanitizers",
      "configurePreset": "linux-sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
