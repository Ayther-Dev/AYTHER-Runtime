<?xml version="1.0" encoding="utf-8"?>
<!--
  Reference copy of the SignPath artifact configuration "windows-package" of
  the AYTHER-Runtime project. SignPath reads the copy stored in the project;
  keep both identical.

  Input: the GitHub artifact "unsigned-windows" (a ZIP wrapping the CPack ZIP).
  Only the executable built from this repository is signed; the bundled
  third-party DLLs (SDL3, toml++, Vulkan loader, zstd) are left as shipped.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <zip-file path="ayther-runtime-*-Windows-AMD64-Runtime.zip">
      <pe-file path="bin/ayther_runtime.exe">
        <authenticode-sign />
      </pe-file>
    </zip-file>
  </zip-file>
</artifact-configuration>
